server {
    listen       ${PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # ── SPA routing: rutas de Vue Router caen a index.html ──────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Health check para Cloud Run ─────────────────────────────────────────
    location = /healthz {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    # ── Cache: sin cache para index.html (siempre la versión más reciente) ──
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # ── Cache: cache largo para assets de Vite (nombres con hash) ───────────
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ── Gzip ─────────────────────────────────────────────────────────────────
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ── Seguridad ─────────────────────────────────────────────────────────────
    server_tokens off;

    location ~ /\. {
        deny all;
    }
}
