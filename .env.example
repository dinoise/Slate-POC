# ── Root .env.example — variables para docker compose ────────────────────────
# Copiar a .env. Solo contiene variables de infraestructura local (postgres,
# redis, herramientas). Las variables de cada servicio están en:
#   services/api/.env.example
#   services/notifications/.env.example
#   apps/admin/.env.example
#   apps/adjuster/.env.example
#   apps/reporter/.env.example

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=slate
POSTGRES_PASSWORD=slate
POSTGRES_DB=slate_dev
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Routing providers (puertos para compose profiles) ─────────────────────────
OSRM_PORT=5001
VALHALLA_PORT=8002

# ── PgAdmin (profile: tools) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@slate.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── Jupyter (profile: tools) ──────────────────────────────────────────────────
JUPYTER_TOKEN=slate-dev
JUPYTER_PORT=8888
