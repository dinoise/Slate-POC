# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=despacho
POSTGRES_PASSWORD=despacho
POSTGRES_DB=despacho_dev
POSTGRES_PORT=5432

# URL completa para SQLAlchemy (asyncpg) y Alembic
DATABASE_URL=postgresql+asyncpg://despacho:despacho@localhost:5432/despacho_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Routing providers ─────────────────────────────────────────────────────────
# Opciones: osrm | valhalla | google
ROUTING_PROVIDER=osrm

OSRM_BASE_URL=http://localhost:5001
OSRM_PORT=5001

VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_PORT=8002

# Solo si usas Google Routes API
GOOGLE_ROUTES_API_KEY=

# ── API Backend ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Notifications service ─────────────────────────────────────────────────────
NOTIFICATIONS_PORT=8001

# ── PgAdmin (profile: tools) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@despacho.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── Jupyter (profile: tools) ──────────────────────────────────────────────────
JUPYTER_TOKEN=despacho-dev
JUPYTER_PORT=8888

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Copiar a apps/*/env.development con los valores correctos
VITE_API_BASE_URL=http://localhost:8000
VITE_NOTIFICATIONS_URL=http://localhost:8001
