{
  "name": "slate",
  "private": true,
  "version": "0.1.0",
  "description": "Slate monorepo — incident dispatch and adjuster assignment",
  "scripts": {
    "dev:admin": "pnpm --filter @slate/admin dev",
    "dev:reporter": "pnpm --filter @slate/reporter dev",
    "dev:adjuster": "pnpm --filter @slate/adjuster dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "test": "pnpm --filter \"./apps/*\" test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
