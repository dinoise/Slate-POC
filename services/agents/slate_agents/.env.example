# ── slate_agents — .env para adk web ─────────────────────────────────────────
# ADK carga el .env desde el directorio del agente (este directorio).
# Copiar a .env y rellenar.

# CRÍTICO: fuerza backend Vertex AI. Sin esto ADK usa Gemini API y pide API key.
GOOGLE_GENAI_USE_VERTEXAI=1

# Google Cloud
GOOGLE_CLOUD_PROJECT=lennken-poc
GOOGLE_CLOUD_LOCATION=us-central1

# Modelo
ROOT_AGENT_MODEL=gemini-2.5-flash-lite

# URL de slate-api (para tools que llamen al backend)
SLATE_API_URL=http://localhost:8000

# Log level
LOG_LEVEL=INFO