# ── services/agents — variables de entorno ──────────────────────────────────
# Copiar a .env y rellenar para desarrollo local con `adk web`.

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Google Cloud ──────────────────────────────────────────────────────────────
# CRÍTICO: fuerza el backend Vertex AI en lugar de Gemini API.
# Sin esta var ADK pide GOOGLE_API_KEY (Gemini API mode).
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=lennken-poc
GOOGLE_CLOUD_LOCATION=us-central1

# ── Modelo del root agent ─────────────────────────────────────────────────────
ROOT_AGENT_MODEL=gemini-2.0-flash-001

# ── URL de slate-api (para que las tools llamen al backend) ──────────────────
# En local: apunta al servidor uvicorn local (services/api)
# En producción: URL del Cloud Run de slate-api
SLATE_API_URL=http://localhost:8000

# ── Staging bucket (requerido para adk deploy agent_engine) ───────────────────
# En local no se necesita — solo para el workflow de deploy en CI
# GCS_STAGING_BUCKET=gs://lennken-poc-agents-staging
