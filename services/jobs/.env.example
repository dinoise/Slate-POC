# ── services/jobs — variables de entorno ──────────────────────────────────────
# Copiar a .env y rellenar con valores reales.
# En Cloud Run estas variables se inyectan desde Secret Manager y el workflow
# de deploy — este archivo es solo para ejecución local de los jobs.
#
# Jobs disponibles:
#   demand-refresh   →  slate_jobs.demand_refresh.main
#   optimize         →  slate_jobs.optimize.main

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Debe coincidir con el postgres levantado por docker compose en el root.
# Usado por: demand-refresh, optimize
DATABASE_URL=postgresql+asyncpg://slate:slate@localhost:5432/slate_dev

# ── Logging ───────────────────────────────────────────────────────────────────
# Vacío → DEBUG en development, INFO en production (via effective_log_level)
LOG_LEVEL=

# ── Cloud Storage — artefactos del modelo (demand-refresh) ───────────────────
GCS_BUCKET=lennken-poc-models
MODEL_VERSION=v1.0.0

# ── Comportamiento demand-refresh ─────────────────────────────────────────────
# Número de slots horarios a generar por ejecución (1 slot = 1 hora UTC).
HOURS_AHEAD=24
# Umbral mínimo de pred_abs para incluir un hexágono en el upsert.
PRED_ABS_THRESHOLD=0.5
