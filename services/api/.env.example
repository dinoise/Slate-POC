# ── services/api — variables de entorno ──────────────────────────────────────
# Copiar a .env y rellenar con valores reales.
# En Cloud Run estas variables llegan del workflow — este archivo es solo
# para desarrollo local.

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Debe coincidir con el postgres levantado por docker compose en el root.
DATABASE_URL=postgresql+asyncpg://slate:slate@localhost:5432/slate_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Proveedor de rutas ────────────────────────────────────────────────────────
# Opciones: osrm | valhalla | google
TRAFFIC_PROVIDER=osrm
OSRM_URL=http://localhost:5001
VALHALLA_URL=http://localhost:8002
GOOGLE_ROUTES_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Acepta uno o varios client IDs separados por coma.
# Si está vacío, la verificación se omite (útil para tests locales).
GOOGLE_CLIENT_ID=admin-client-id.apps.googleusercontent.com,adjuster-client-id.apps.googleusercontent.com

# ── Audiences de servicios internos ──────────────────────────────────────────
# URLs base del Cloud Run de slate-api, separadas por coma.
# Permite que los agentes de Vertex AI Agent Engine llamen a slate-api usando
# un ID token de service account (fetch_id_token) en lugar de un token de usuario.
# El token generado por el agente tiene aud = <URL de este servicio>.
# En local dejar vacío — la verificación se omite si GOOGLE_CLIENT_ID también está vacío.
# En producción: obtener con `gcloud run services describe slate-api-dev --format='value(status.url)'`
GOOGLE_SERVICE_AUDIENCES=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
