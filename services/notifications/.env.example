# ── services/notifications — variables de entorno ────────────────────────────
# Copiar a .env y rellenar con valores reales.
# En Cloud Run estas variables llegan del workflow — este archivo es solo
# para desarrollo local.

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Debe coincidir con el postgres levantado por docker compose en el root.
DATABASE_URL=postgresql+asyncpg://slate:slate@localhost:5432/slate_dev

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Acepta uno o varios client IDs separados por coma.
# Si está vacío, la verificación se omite (útil para tests locales).
GOOGLE_CLIENT_ID=admin-client-id.apps.googleusercontent.com,adjuster-client-id.apps.googleusercontent.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
